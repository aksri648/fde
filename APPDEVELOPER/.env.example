# Copy this file to .env and fill in your values
# Get your Anthropic API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API authentication key for APPDEVELOPER service
APPDEVELOPER_API_KEY=your_appdeveloper_api_key_here

# Database URL (default: sqlite+aiosqlite:///./appdeveloper.db)
DATABASE_URL=sqlite+aiosqlite:///./appdeveloper.db

# Workspace root for isolated job workspaces
APPDEVELOPER_WORKSPACE_ROOT=./workspaces

# Require HTTPS in production (default: false for development)
APPDEVELOPER_REQUIRE_HTTPS=false

# Maximum concurrent generation jobs
APPDEVELOPER_MAX_CONCURRENT_JOBS=5
