APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://fde_user:change_me@postgres:5432/fde_backend
REDIS_URL=redis://redis:6379/0
FDE_API_KEY=
# Secret used to verify JWT bearer tokens (HS256). Leave empty in development to
# accept unverified tokens; REQUIRED in staging/production or JWT auth is rejected.
FDE_JWT_SECRET=
# LLM routing: point ANTHROPIC_BASE_URL at your LiteLLM proxy so the planner's
# Anthropic-format calls are translated to your OpenAI-compatible backend.
ANTHROPIC_BASE_URL=http://localhost:4000
ANTHROPIC_API_KEY=
# Model name/alias to request (must match a model_name in litellm_config.yaml)
FDE_CLAUDE_MODEL=fde-claude
CLAUDE_AGENT_SDK_TIMEOUT_SECONDS=90
LITELLM_PROXY_URL=http://litellm:4000
LITELLM_MASTER_KEY=
APPDEVELOPER_BASE_URL=http://localhost:8001
APPDEVELOPER_API_KEY=
LLMDEPLOYER_BASE_URL=http://localhost:8002
LLMDEPLOYER_API_KEY=
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_SECONDS=1
REQUEST_MAX_BYTES=65536
PLANNER_MODE=real
